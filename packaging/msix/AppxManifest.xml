<?xml version="1.0" encoding="utf-8"?>
<!-- Full-trust desktop app package. build_msix.ps1 fills in Version; Name / Publisher must match what Partner
     Center gives you (Product identity page) or your signing certificate's subject. -->
<Package xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
         xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
         xmlns:desktop="http://schemas.microsoft.com/appx/manifest/desktop/windows10"
         xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
         IgnorableNamespaces="uap desktop rescap">
  <Identity Name="yensobased1.Nullpoint" Publisher="CN=REPLACE_WITH_PUBLISHER" Version="2.2.0.0"
            ProcessorArchitecture="x64" />
  <Properties>
    <DisplayName>Nullpoint</DisplayName>
    <PublisherDisplayName>yensobased1</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
    <Description>Simple, clean crosshair overlay for Windows. Click-through window: no game injection.</Description>
  </Properties>
  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.19041.0" MaxVersionTested="10.0.26100.0" />
  </Dependencies>
  <Resources>
    <Resource Language="en-us" />
  </Resources>
  <Applications>
    <Application Id="Nullpoint" Executable="Nullpoint.exe" EntryPoint="Windows.FullTrustApplication">
      <uap:VisualElements DisplayName="Nullpoint" Description="Crosshair overlay" BackgroundColor="transparent"
                          Square150x150Logo="Assets\Square150x150Logo.png" Square44x44Logo="Assets\Square44x44Logo.png">
        <uap:DefaultTile Wide310x150Logo="Assets\Wide310x150Logo.png" />
      </uap:VisualElements>
      <Extensions>
        <!-- Packaged apps can't use the HKCU Run key / protocol registry entries the normal build writes. -->
        <uap:Extension Category="windows.protocol">
          <uap:Protocol Name="nullpoint">
            <uap:DisplayName>Nullpoint crosshair link</uap:DisplayName>
          </uap:Protocol>
        </uap:Extension>
        <desktop:Extension Category="windows.startupTask" Executable="Nullpoint.exe" EntryPoint="Windows.FullTrustApplication">
          <desktop:StartupTask TaskId="NullpointStartup" Enabled="false" DisplayName="Nullpoint" />
        </desktop:Extension>
      </Extensions>
    </Application>
  </Applications>
  <Capabilities>
    <rescap:Capability Name="runFullTrust" />
  </Capabilities>
</Package>
